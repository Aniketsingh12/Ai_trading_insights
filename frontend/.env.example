# Frontend build config (Vite reads VITE_* at build time).
#
# Leave BLANK for:
#   - local dev (Vite proxies /api to the backend — see vite.config.js)
#   - the single-service Railway deploy (FastAPI serves this app, same origin)
#
# Set it only when the frontend is hosted separately from the API — a Vercel
# build, or the Capacitor APK (which has no proxy). Include the /api prefix,
# since the backend namespaces every endpoint under it.
# Copy this file to `.env.production` and fill it in before building.
#
# VITE_API_URL=https://your-app.up.railway.app/api
VITE_API_URL=
