# Frontend build config (Vite reads VITE_* at build time).
#
# Leave BLANK for local dev — the app falls back to '/api' and Vite proxies it
# to http://localhost:8000 (see vite.config.js).
#
# For a production WEB build (Vercel) or the Capacitor APK, set this to your
# deployed backend's absolute URL. The APK has no proxy, so this is REQUIRED
# there. Copy this file to `.env.production` and fill it in before building.
#
# VITE_API_URL=https://tradeforge-api.onrender.com
VITE_API_URL=
