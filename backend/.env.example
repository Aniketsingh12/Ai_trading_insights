# Copy to backend/.env and fill in. On Render, set these in the dashboard instead.

# ─── LLM Provider ─────────────────────────────────────────
# 'openai_compat' (Groq free) | 'gemini' (Google free) | 'ollama' (local) | 'anthropic'
LLM_PROVIDER=gemini

# Google Gemini (free) — get a key at aistudio.google.com/apikey. Only the key is needed.
GEMINI_API_KEY=
GEMINI_MODEL_QUICK=gemini-2.0-flash
GEMINI_MODEL_AGENT=gemini-2.0-flash
GEMINI_MODEL_REPORT=gemini-2.5-flash

# OpenAI-compatible (Groq free / OpenRouter / Together / HF)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL_QUICK=llama-3.1-8b-instant
OPENAI_MODEL_AGENT=llama-3.3-70b-versatile
OPENAI_MODEL_REPORT=llama-3.3-70b-versatile

# Anthropic (Claude API) — used only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL_QUICK=claude-haiku-4-5-20251001
CLAUDE_MODEL_AGENT=claude-sonnet-4-6
CLAUDE_MODEL_REPORT=claude-opus-4-8

# Ollama (local OSS) — used only if LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_QUICK=llama3.1:8b
OLLAMA_MODEL_AGENT=qwen2.5:7b
OLLAMA_MODEL_REPORT=qwen2.5:7b

# ─── CORS: comma-separated allowed frontend origins ───────
# Local dev + Capacitor app + (add your deployed frontend URL when live)
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost,http://localhost

# ─── Optional market-data APIs (free fallbacks used if blank) ─────
POLYGON_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=

# ─── Optional infra ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ENV=development
LOG_LEVEL=INFO
