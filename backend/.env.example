# Copy to backend/.env and fill in. On Render, set these in the dashboard instead.

# ─── LLM Provider ─────────────────────────────────────────
# 'together' | 'gemini' (free) | 'openai_compat' (Groq free) | 'ollama' (local) | 'anthropic'
LLM_PROVIDER=together

# Together AI (paid, wide open-model catalogue) — key from api.together.ai.
# Only the key is needed; base URL and models below are preset.
# Tiering: cheap models for frequent calls, flagship only for the final synthesis.
TOGETHER_API_KEY=
TOGETHER_MODEL_QUICK=openai/gpt-oss-20b                    # $0.05 / $0.20 per 1M
TOGETHER_MODEL_AGENT=deepseek-ai/DeepSeek-V4-Flash-0731    # $0.14 / $0.28 per 1M
TOGETHER_MODEL_REPORT=openai/gpt-oss-120b                  # $0.15 / $0.60 per 1M
# The report tier is one call but ~85% of a deep run's cost, because it reads
# all four analyst outputs. It's also the only output that gets parsed, so
# compare candidates before going cheaper still:
#   .venv/Scripts/python.exe scripts/eval_report_model.py

# Google Gemini (free) — get a key at aistudio.google.com/apikey. Only the key is needed.
GEMINI_API_KEY=
GEMINI_MODEL_QUICK=gemini-2.0-flash
GEMINI_MODEL_AGENT=gemini-2.0-flash
GEMINI_MODEL_REPORT=gemini-2.5-flash

# OpenAI-compatible (Groq free / OpenRouter / Together / HF)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL_QUICK=llama-3.1-8b-instant
OPENAI_MODEL_AGENT=llama-3.3-70b-versatile
OPENAI_MODEL_REPORT=llama-3.3-70b-versatile

# Anthropic (Claude API) — used only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL_QUICK=claude-haiku-4-5-20251001
CLAUDE_MODEL_AGENT=claude-sonnet-4-6
CLAUDE_MODEL_REPORT=claude-opus-4-8

# Ollama (local OSS) — used only if LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_QUICK=llama3.1:8b
OLLAMA_MODEL_AGENT=qwen2.5:7b
OLLAMA_MODEL_REPORT=qwen2.5:7b

# ─── CORS: comma-separated allowed frontend origins ───────
# Local dev + Capacitor app + (add your deployed frontend URL when live)
CORS_ORIGINS=http://localhost:5173,https://localhost,capacitor://localhost,http://localhost

# ─── Optional market-data APIs (free fallbacks used if blank) ─────
POLYGON_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=

# ─── Public-demo guards (all OFF by default) ──────────────
# For a portfolio deployment: visitors CAN run the AI features — that's the
# point — but metered, with a hard ceiling on what it can ever cost.
# Everything else (quotes, charts, the 0-100 scoring maths, watchlist,
# portfolio) is free to serve and never metered.
#
# One deep-research run = 5 units (it makes 5 model calls). Everything else = 1.
# Keep VISITOR_LLM_LIMIT at 5 or more or that feature can never run; the app
# logs a warning at startup if you don't.
#
# VISITOR_LLM_LIMIT   what one visitor gets per UTC day.  Suggested: 10
# DAILY_LLM_LIMIT     ceiling across ALL visitors per day. Suggested: 60
# API_ACCESS_KEY      your own passcode — bypasses both, so visitors can never
#                     lock you out of your own demo. Enter it once in the app
#                     (the AI chip in the header).
# RATE_LIMIT_PER_MIN  per-IP burst cap. Data routes get 8x automatically.
VISITOR_LLM_LIMIT=0
DAILY_LLM_LIMIT=0
API_ACCESS_KEY=
RATE_LIMIT_PER_MIN=0

# ─── Optional infra ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
ENV=development
LOG_LEVEL=INFO
